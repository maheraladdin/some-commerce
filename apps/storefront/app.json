{
  "expo": {
    "name": "some-commerce",
    "slug": "some-commerce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.somecommerce.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080A0F"
      },
      "package": "com.somecommerce.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
