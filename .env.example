# ==============================================================================
# some-commerce Environment Configuration Template
# Copy to .env for local development
# ==============================================================================

# --- Node & Expo Environment ---
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
EXPO_PUBLIC_DEFAULT_LOCALE=ar-EG
EXPO_PUBLIC_ENABLE_DEVTOOLS=true

# --- AWS Cloud Infrastructure ---
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=123456789012
DYNAMODB_TABLE_NAME=some-commerce-production-single-table
KMS_MASTER_KEY_ARN=arn:aws:kms:eu-central-1:123456789012:key/some-commerce-master

# --- Cognito & Identity ---
COGNITO_USER_POOL_ID=eu-central-1_SomeUserPool
COGNITO_CLIENT_ID=someclientid1234567890
JWKS_CACHE_TTL_SECS=86400

# --- Caching (L1 Moka + L2 Redis) ---
REDIS_URL=redis://localhost:6379
MOKA_MAX_CAPACITY=100000
MOKA_TTL_SECS=300

# --- OpenSearch / Elasticsearch ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=some-commerce-catalog

# --- Payment Gateways ---
PAYMOB_API_KEY=paymob_sec_test_12345
PAYMOB_INTEGRATION_ID=12345
PAYMOB_HMAC_SECRET=paymob_hmac_secret_token
STRIPE_SECRET_KEY=sk_test_12345
STRIPE_WEBHOOK_SECRET=whsec_test_12345

# --- Tax & Fiscalization (ZATCA) ---
ZATCA_ENVIRONMENT=simulation
ZATCA_CSID=sample_csid_base64_certificate
